/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: payment=(), camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://exe-storage.stevepalmer.uk https://protomaps.github.io; font-src 'self' data:; frame-ancestors 'none'

/lsoa-exe.geojson
  Cache-Control: public, max-age=86400

/river-exe.geojson
  Cache-Control: public, max-age=86400

/*.pmtiles
  Cache-Control: public, max-age=31536000, immutable
