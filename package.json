{
	"name": "river-exe",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare",
		"filter-lsoas": "tsx scripts/filter-lsoas.ts",
		"build-lsoa-tiles": "tippecanoe -o static/lsoa-exe.pmtiles --layer=lsoa --minimum-zoom=6 --maximum-zoom=12 --no-feature-limit --no-tile-size-limit --no-line-simplification --no-tiny-polygon-reduction --force static/lsoa-exe.geojson"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.30.1",
		"@sveltejs/adapter-cloudflare": "latest",
		"@sveltejs/enhanced-img": "^0.10.4",
		"@sveltejs/kit": "latest",
		"@sveltejs/vite-plugin-svelte": "latest",
		"@tailwindcss/vite": "^4.1.15",
		"@types/mapbox__mapbox-gl-draw": "^1.4.9",
		"@types/stream-json": "^1.7.8",
		"bits-ui": "^2.14.2",
		"clsx": "^2.1.1",
		"concurrently": "^9.2.1",
		"stream-json": "^1.8.0",
		"svelte": "^5.0.0",
		"tailwind-merge": "^3.3.1",
		"tsx": "^4.19.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "latest",
		"vite": "latest",
		"wrangler": "latest",
		"zod": "^4.0.0"
	},
	"dependencies": {
		"@lucide/svelte": "^0.544.0",
		"@mapbox/mapbox-gl-draw": "^1.5.1",
		"@svelte-maplibre-gl/pmtiles": "latest",
		"maplibre-gl": "^5.9.0",
		"svelte-maplibre-gl": "^1.0.1",
		"svelte-sonner": "^1.0.5",
		"tailwind-variants": "^3.2.2"
	},
	"overrides": {
		"fast-xml-parser": ">=5.3.4"
	}
}
